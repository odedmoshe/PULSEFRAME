{
  "name": "pulseframe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pulseframe/server --filter @pulseframe/web dev",
    "build": "pnpm --filter @pulseframe/web build",
    "start": "pnpm --filter @pulseframe/server start",
    "backup": "tsx apps/server/src/backup-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fixtures": "tsx packages/fixtures/src/cli.ts",
    "probe": "tsx apps/renderer/src/probe-cli.ts",
    "proof": "tsx packages/evals/src/phase0-proof.ts",
    "proof:g0": "tsx packages/evals/src/g0-proof.ts",
    "conformance:seek": "tsx packages/evals/src/seek-conformance.ts",
    "check:notices": "tsx packages/evals/src/notices-check.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:notices && pnpm proof",
    "trial:birefnet": "tsx packages/evals/src/g1-birefnet-trial.ts",
    "conformance:avsync": "tsx packages/evals/src/av-sync-long.ts",
    "proof:phase3": "tsx packages/evals/src/phase3-proof.ts",
    "proof:phase4": "tsx packages/evals/src/phase4-proof.ts",
    "proof:browser-export": "tsx packages/evals/src/browser-export-proof.ts",
    "conformance:parity": "tsx packages/evals/src/parity-suite.ts",
    "conformance:long": "tsx packages/evals/src/long-media.ts",
    "proof:reverse-sound": "tsx packages/evals/src/reverse-sound-proof.ts",
    "proof:pitch": "tsx packages/evals/src/pitch-proof.ts",
    "proof:speech": "tsx packages/evals/src/speech-proof.ts",
    "check:media": "tsx packages/evals/src/real-media-check.ts",
    "proof:voice": "tsx packages/evals/src/voice-proof.ts",
    "conformance:start-offset": "tsx packages/evals/src/start-offset.ts",
    "conformance:inputs": "tsx packages/evals/src/input-matrix.ts",
    "conformance:images": "tsx packages/evals/src/image-matrix.ts",
    "conformance:projects": "tsx packages/evals/src/project-matrix.ts",
    "conformance:render-fuzz": "tsx packages/evals/src/render-fuzz.ts",
    "proof:phase5": "tsx packages/evals/src/phase5-proof.ts",
    "proof:phase6": "tsx packages/evals/src/phase6-proof.ts",
    "proof:phase7": "tsx packages/evals/src/phase7-proof.ts",
    "proof:phase8": "tsx packages/evals/src/phase8-proof.ts",
    "proof:phase9": "tsx packages/evals/src/phase9-proof.ts",
    "proof:speed": "tsx packages/evals/src/speed-proof.ts",
    "proof:phase12": "tsx packages/evals/src/phase12-proof.ts",
    "proof:phase11": "tsx packages/evals/src/phase11-proof.ts",
    "audit:a11y": "tsx packages/evals/src/a11y-audit.ts",
    "soak": "tsx packages/evals/src/soak.ts",
    "proof:editor-interactions": "tsx packages/evals/src/editor-interactions-proof.ts",
    "proof:owner-ui": "tsx packages/evals/src/owner-ui-proof.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
